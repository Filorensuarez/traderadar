#!/bin/sh
# Bootstrap launcher. prepare-gradle-wrapper.mjs replaces this with the official
# Gradle 8.9 generated launcher after verifying the Wrapper and distribution.
set -eu
APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -f "$APP_DIR/gradle/wrapper/gradle-wrapper.jar" ]; then
  echo 'Gradle Wrapper jar is missing. From the repository root run npm run prepare:android:wrapper with trusted Gradle 8.9 installed.' >&2
  exit 1
fi
if [ -n "${JAVA_HOME:-}" ]; then
  JAVA_CMD="$JAVA_HOME/bin/java"
else
  JAVA_CMD=java
fi
exec "$JAVA_CMD" -classpath "$APP_DIR/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
